import cv2
import numpy as np

# Load COCO classes
classesFile = 'coco80.names'  # Ensure this file is in the correct path
with open(classesFile, 'r') as f:
    classes = f.read().strip().splitlines()

# Load YOLO model
weights_path = "C:/Users/240064026/PycharmProjects/PythonProject1/Resources/yolov3-320.weights"
config_path = "C:/Users/240064026/PycharmProjects/PythonProject1/Resources/yolov3-320.cfg"
net = cv2.dnn.readNet(weights_path, config_path)

# Get layer names
layerNames = net.getLayerNames()
outputLayers = [layerNames[i - 1] for i in net.getUnconnectedOutLayers().flatten()]

# Capture video from camera
cap = cv2.VideoCapture(0)

while True:
    success, img = cap.read()
    if not success:
        break

    height, width, _ = img.shape

    # Create blob and perform forward propagation
    blob = cv2.dnn.blobFromImage(img, 0.00392, (416, 416), (0, 0, 0), True, crop=False)
    net.setInput(blob)
    outputs = net.forward(outputLayers)

    boxes, confidences, class_ids = [], [], []

    # Iterate through detection results
    for output in outputs:
        for detection in output:
            scores = detection[5:]  # Get confidence scores
            class_id = np.argmax(scores)  # Get index of highest score
            confidence = scores[class_id]  # Get corresponding confidence
            if confidence > 0.5:  # Set confidence threshold
                center_x = int(detection[0] * width)
                center_y = int(detection[1] * height)
                w = int(detection[2] * width)
                h = int(detection[3] * height)

                # Rectangle coordinates
                x = int(center_x - w / 2)
                y = int(center_y - h / 2)

                boxes.append([x, y, w, h])
                confidences.append(float(confidence))
                class_ids.append(class_id)

    # Apply Non-Maximum Suppression (NMS)
    indices = cv2.dnn.NMSBoxes(boxes, confidences, 0.5, 0.4)

    # Draw bounding boxes
    if len(indices) > 0:
        for i in indices.flatten():  # Ensure extracted indices are flattened
            box = boxes[i]
            x, y, w, h = box
            label = classes[class_ids[i]]  # Use class name
            cv2.rectangle(img, (x, y), (x + w, y + h), (255, 0, 0), 2)
            cv2.putText(img, label, (x, y + 30), cv2.FONT_HERSHEY_PLAIN, 3, (255, 0, 0), 3)

    cv2.imshow('Image', img)
    if cv2.waitKey(1) & 0xFF == 27:  # Press 'Esc' key to exit
        break

cap.release()
cv2.destroyAllWindows()
