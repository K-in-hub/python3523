import cv2
import time

class YOLODetector:
    def __init__(self, model_config, model_weights):
        self.net = cv2.dnn.readNetFromDarknet(model_config, model_weights)

    def detect(self, image):
        blob = cv2.dnn.blobFromImage(image, 1 / 255.0, (608, 608), swapRB=True, crop=False)
        self.net.setInput(blob)
        output_layers_names = self.net.getUnconnectedOutLayersNames()
        detections = self.net.forward(output_layers_names)
        return detections

def measure_fps(yolo_model, model_name, video_source=0):
    cap = cv2.VideoCapture(video_source)
    frame_count = 0
    start_time = time.time()

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        # Detection
        yolo_model.detect(frame)
        frame_count += 1

        # Update FPS every second
        elapsed_time = time.time() - start_time
        if elapsed_time >= 1.0:
            current_fps = frame_count
            print(f"{model_name} FPS: {current_fps}")
            frame_count = 0
            start_time = time.time()

            # Display FPS on frame
            cv2.putText(frame, f"FPS: {current_fps}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)

        cv2.imshow("Frame", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

